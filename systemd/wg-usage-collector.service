[Unit]
Description=Collect WireGuard usage statistics
After=network-online.target wg-quick@wg0.service

[Service]
Type=oneshot
User=wgadmin
WorkingDirectory=/opt/wg-admin
EnvironmentFile=/opt/wg-admin/.env
ExecStart=/opt/wg-admin/.venv/bin/python /opt/wg-admin/manage.py collect_wg_usage --enforce-limits
